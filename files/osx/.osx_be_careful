#!/usr/bin/env bash
# set -eux
set -o pipefail

# Mac OS X configuration
#
# This configuration applies to the latest version of macOS (currently 11.3),
# and sets up preferences and configurations for all the built-in services and
# apps. Third-party app config should be done elsewhere.
#
# Options:
#   --restart: Restart some apps and services after running the script.
#
# If you want to figure out what default needs changing, do the following:
#
#   1. `cd /tmp`
#   2. Store current defaults in file: `defaults read > before`
#   3. Make a change to your system.
#   4. Store new defaults in file: `defaults read > after`
#   5. Diff the files: `diff before after`
#
# @see: http://secrets.blacktree.com/?showapp=com.apple.finder
# @see: https://github.com/herrbischoff/awesome-macos-command-line
#
# @author Jeff Geerling
#    +
# ~/.macos — https://mths.be/macos

# Put here other commands to help set up the system.
# This file should not be run very often, as the idempotency is not guaranteed.

# Close any open System Preferences panes, to prevent them from overriding
# settings we’re about to change
osascript -e 'tell application "System Preferences" to quit'

# Warn that some commands will not be run if the script is not run as root.
if [[ $EUID -ne 0 ]]; then
  printf "Certain commands will not be run without sudo privileges. To skip this warning, run the same command prepended with 'sudo', for example: $ sudo $0\n\n" | fold -s -w 80
fi

# Ask for the administrator password upfront
sudo -v

echo "OK. Continuing..."

# Keep-alive: update existing `sudo` time stamp until `.macos` has finished
while true; do sudo -n true; sleep 60; kill -0 "$$" || exit; done 2>/dev/null &

###############################################################################
# General UI/UX                                                               #
###############################################################################

# Remove duplicates in the “Open With” menu (also see `lscleanup` alias)
/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister -kill -r -domain local -domain system -domain user

# Fix for the ancient UTF-8 bug in QuickLook (https://mths.be/bbo)
# Commented out, as this is known to cause problems in various Adobe apps :(
# See https://github.com/mathiasbynens/dotfiles/issues/237
#echo "0x08000100:0" > ~/.CFUserTextEncoding

# Disable Notification Center and remove the menu bar icon
launchctl unload -w /System/Library/LaunchAgents/com.apple.notificationcenterui.plist 2> /dev/null

# Set a custom wallpaper image. `DefaultDesktop.jpg` is already a symlink, and
# all wallpapers are in `/Library/Desktop Pictures/`. The default is `Wave.jpg`.
#rm -rf ~/Library/Application Support/Dock/desktoppicture.db
#sudo rm -rf /System/Library/CoreServices/DefaultDesktop.jpg
#sudo ln -s /path/to/your/image /System/Library/CoreServices/DefaultDesktop.jpg

# Set background/wallpaper to black color if wallpaper-dl is not cloned
if [ ! -d "$HOME/git/wallpaper-dl" ]; then
	osascript -e 'tell application "Finder" to set desktop picture to POSIX file "/System/Library/Desktop Pictures/Solid Colors/Black.png"'
fi

###############################################################################
# Trackpad, mouse, keyboard, Bluetooth accessories, and input                 #
###############################################################################

# Set the timezone; see `sudo systemsetup -listtimezones` for other values
# sudo systemsetup -settimezone "Europe/Lisbon" > /dev/null

# Stop iTunes from responding to the keyboard media keys
launchctl unload -w /System/Library/LaunchAgents/com.apple.rcd.plist 2> /dev/null

###############################################################################
# Safari & WebKit                                                             #
###############################################################################

# Remove useless icons from Safari's bookmarks bar
sudo defaults write com.apple.Safari ProxiesInBookmarksBar -array

###############################################################################
# Energy saving                                                               #
###############################################################################

# Enable lid wakeup
sudo pmset -a lidwake 0

# Restart automatically on power loss
sudo pmset -a autorestart 1

# Restart automatically if the computer freezes
sudo systemsetup -setrestartfreeze on

# Turn off the display after 5 minutes
sudo pmset -a displaysleep 5

# (Set to "0" to disable machine sleep while charging)
sudo pmset -c sleep 0

# Set machine sleep to 6 minutes on battery (RAM ON; CPU OFF)
sudo pmset -b sleep 6

# Set hibernate delay (RAM OFF; CPU OFF)
sudo pmset -a standbydelay 3600 # 1h (default)
# sudo pmset -a standbydelay 86400 # 24h

# TODO
# Never go into computer sleep mode
sudo systemsetup -setcomputersleep Off > /dev/null

# Hibernation mode
# 0: Disable hibernation (speeds up entering sleep mode)
# 3: Copy RAM to disk so the system state can still be restored in case of a
#    power failure.
sudo pmset -a hibernatemode 0

# Remove the sleep image file to save disk space
# sudo rm /private/var/vm/sleepimage
# Create a zero-byte file instead…
# sudo touch /private/var/vm/sleepimage
# …and make sure it can’t be rewritten
# sudo chflags uchg /private/var/vm/sleepimage

###############################################################################
# Finder                                                                      #
###############################################################################
for VIEW_SETTINGS in DesktopViewSettings FK_StandardViewSettings StandardViewSettings; do
  # Show item info near icons on the desktop and in other icon views
  /usr/libexec/PlistBuddy -c "Set :$VIEW_SETTINGS:IconViewSettings:showItemInfo true" ~/Library/Preferences/com.apple.finder.plist

	# Enable snap-to-grid for icons on the desktop and in other icon views
  /usr/libexec/PlistBuddy -c "Set :$VIEW_SETTINGS:IconViewSettings:arrangeBy grid" ~/Library/Preferences/com.apple.finder.plist

	# Increase grid spacing for icons on the desktop and in other icon views
	/usr/libexec/PlistBuddy -c "Set :$VIEW_SETTINGS:IconViewSettings:gridSpacing 100" ~/Library/Preferences/com.apple.finder.plist

	# Increase the size of icons on the desktop and in other icon views
	/usr/libexec/PlistBuddy -c "Set :$VIEW_SETTINGS:IconViewSettings:iconSize 80" ~/Library/Preferences/com.apple.finder.plist
done

# Show item info to the right of the icons on the desktop
/usr/libexec/PlistBuddy -c "Set DesktopViewSettings:IconViewSettings:labelOnBottom false" ~/Library/Preferences/com.apple.finder.plist

# Show the ~/Library folder
chflags nohidden ~/Library

# Show the /Volumes folder
sudo chflags nohidden /Volumes

# Remove Dropbox’s green checkmark icons in Finder
# file=/Applications/Dropbox.app/Contents/Resources/emblem-dropbox-uptodate.icns
# [ -e "${file}" ] && mv -f "${file}" "${file}.bak"

###############################################################################
# Dock, Dashboard, and hot corners                                            #
###############################################################################

# Add iOS & Watch Simulator to Launchpad
[[ -f "/Applications/Xcode.app/Contents/Developer/Applications/Simulator.app" ]] && sudo ln -sf "/Applications/Xcode.app/Contents/Developer/Applications/Simulator.app" "/Applications/Simulator.app"
[[ -f "/Applications/Xcode.app/Contents/Developer/Applications/Simulator (Watch).app" ]] && sudo ln -sf "/Applications/Xcode.app/Contents/Developer/Applications/Simulator (Watch).app" "/Applications/Simulator (Watch).app"

